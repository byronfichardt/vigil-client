{
    "name": "vigil/client",
    "description": "Exception tracking client for Vigil - send your Laravel exceptions to a central Vigil server.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Vigil\\Client\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vigil\\Client\\VigilServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vigil\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    }
}
